generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ════════════════════════════════════════════════════════
// ENUMS
// ════════════════════════════════════════════════════════

// Removed UserRole enum in favor of Role model

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  TIMED_OUT
  ABANDONED
}

enum AssessmentType {
  PERSONALITY
  STREAM_FINDER
  CAREER_APTITUDE
  INTEREST_INVENTORY
  LEARNING_STYLE
  CUSTOM
}

enum ResultVisibility {
  IMMEDIATE
  AFTER_REPORT
  HIDDEN
}

enum ReportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum GeneratedReportStatus {
  PROCESSING
  READY
  FAILED
}

// ════════════════════════════════════════════════════════
// PERMISSIONS
// Permissions (seeded) → assigned to Role via RolePermission
// User has a role enum + optional per-user overrides
// ════════════════════════════════════════════════════════

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  module      String // e.g. "courses", "tests", "questions"
  action      String // e.g. "read", "create", "update", "delete"
  description String?

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String  @id @default(cuid())
  roleId       String
  permissionId String
  granted      Boolean @default(true)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@map("role_permissions")
}

model UserPermission {
  id           String  @id @default(cuid())
  userId       String
  permissionId String
  granted      Boolean @default(true)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@map("user_permissions")
}

// ════════════════════════════════════════════════════════
// USER (Single table for Admin + Student)
// ════════════════════════════════════════════════════════

model User {
  id        String  @id @default(cuid())
  name      String
  email     String  @unique
  phone     String?
  password  String
  roleId    String
  role      Role    @relation(fields: [roleId], references: [id])
  avatar    String?
  isActive  Boolean @default(true)
  isDeleted Boolean @default(false)

  // Student-specific fields (null for admins)
  dateOfBirth DateTime?
  gender      String?
  fatherName  String?
  motherName  String?
  address     String?
  city        String?
  state       String?
  country     String?

  schoolInstitute  String?
  teacherReferrer  String?
  // Security
  lastLoginAt      DateTime?
  lastLoginIp      String?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  // OTP Verification
  isEmailVerified Boolean?  @default(false)
  otp             String?
  otpExpiresAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  testAttempts    TestAttempt[]
  contactMessages ContactMessage[]
  permissions     UserPermission[]

  @@index([roleId])
  @@index([isActive])
  @@index([isDeleted])
  @@map("users")
}

// ════════════════════════════════════════════════════════
// LANGUAGE (Multi-language test support)
// ════════════════════════════════════════════════════════

model Language {
  id       String  @id @default(cuid())
  name     String
  code     String  @unique
  isRtl    Boolean @default(false)
  isActive Boolean @default(true)

  testLanguages        TestLanguage[]
  questionTranslations QuestionTranslation[]
  optionTranslations   OptionTranslation[]

  @@map("languages")
}

model Test {
  id    String @id @default(cuid())
  title String

  assessmentType     AssessmentType   @default(CUSTOM)
  resultVisibility   ResultVisibility @default(IMMEDIATE)
  reportTemplateId   String?
  assessmentSummary  String?          @db.Text
  assessmentMetadata Json?
  duration           Int // Duration in minutes
  minAnswersRequired Int              @default(1)
  instructions       String           @db.Text
  image              String? // Main image path
  termsConditions    String           @db.Text
  isActive           Boolean          @default(true)
  isDeleted          Boolean          @default(false)
  startDate          DateTime? // When test becomes available
  endDate            DateTime? // When test expires
  allowedAttempts    Int              @default(1)
  shuffleQuestions   Boolean          @default(true)
  submissionMessage  String?          @db.Text // Custom popup message on submission (admin-configurable)
  autoSubmit         Boolean          @default(true) // Auto-submit when timer expires
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  questions                     Question[]
  testAttempts                  TestAttempt[]
  testLanguages                 TestLanguage[]
  reportTemplate                ReportTemplate?                @relation(fields: [reportTemplateId], references: [id])
  assessmentGroupMappings       AssessmentGroupMapping[]
  assessmentVersions            AssessmentVersion[]

  @@index([isActive])
  @@index([isDeleted])
  @@index([reportTemplateId])
  @@index([startDate])
  @@index([endDate])
  @@map("tests")
}

// ════════════════════════════════════════════════════════
// TEST → LANGUAGE MAPPING
// ════════════════════════════════════════════════════════

model TestLanguage {
  id         String @id @default(cuid())
  testId     String
  languageId String

  test     Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id])

  @@unique([testId, languageId])
  @@map("test_languages")
}

// ════════════════════════════════════════════════════════
// QUESTION
// ════════════════════════════════════════════════════════

model Question {
  id        String   @id @default(cuid())
  testId    String
  text      String   @db.Text
  topicId   String?
  order     Int
  imageUrl  String? // Optional image for the question
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  test         Test                  @relation(fields: [testId], references: [id], onDelete: Cascade)
  options      Option[]
  translations QuestionTranslation[]
  userAnswers  UserAnswer[]

  @@index([testId])
  @@index([isDeleted])
  @@map("questions")
}

// ════════════════════════════════════════════════════════
// OPTION (Answer choices)
// ════════════════════════════════════════════════════════

model Option {
  id         String  @id @default(cuid())
  questionId String
  text       String
  order      Int
  imageUrl   String? // Optional image for the option

  question         Question                @relation(fields: [questionId], references: [id], onDelete: Cascade)
  translations     OptionTranslation[]
  userAnswers      UserAnswer[]
  assessmentScores AssessmentOptionScore[]

  @@index([questionId])
  @@map("options")
}

// ════════════════════════════════════════════════════════
// TRANSLATIONS
// ════════════════════════════════════════════════════════

model QuestionTranslation {
  id         String @id @default(cuid())
  questionId String
  languageId String
  text       String @db.Text

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id])

  @@unique([questionId, languageId])
  @@map("question_translations")
}

model OptionTranslation {
  id         String @id @default(cuid())
  optionId   String
  languageId String
  text       String

  option   Option   @relation(fields: [optionId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id])

  @@unique([optionId, languageId])
  @@map("option_translations")
}

// ════════════════════════════════════════════════════════
// ASSESSMENT ATTEMPT (Student taking an assessment)
// ════════════════════════════════════════════════════════

model TestAttempt {
  id                  String        @id @default(cuid())
  userId              String
  testId              String
  assessmentVersionId String?
  attemptNumber       Int           @default(1)
  status              AttemptStatus @default(IN_PROGRESS)
  ipAddress           String?
  userAgent           String?
  browserWarnings     Int           @default(0) // Window switch tracking
  isTabSwitched       Boolean       @default(false)
  startTime           DateTime      @default(now())
  endTime             DateTime? // When student submitted
  expiresAt           DateTime // When timer runs out (startTime + duration)
  lastActivityAt      DateTime      @default(now()) // Last student activity used for timer recovery
  selectedLanguage    String        @default("en")
  timeSpent           Int? // Total seconds spent

  totalQuestions Int @default(0)
  attemptedCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User                      @relation(fields: [userId], references: [id])
  test              Test                      @relation(fields: [testId], references: [id])
  assessmentVersion AssessmentVersion?        @relation(fields: [assessmentVersionId], references: [id])
  userAnswers       UserAnswer[]
  assessmentResult  AssessmentResultSnapshot?
  reportJobs        ReportJob[]
  generatedReport   GeneratedReport?

  @@index([userId])
  @@index([testId])
  @@index([assessmentVersionId])
  @@index([status])
  @@index([startTime])
  @@map("test_attempts")
}

// ════════════════════════════════════════════════════════
// ASSESSMENT / PERSONALITY SCORING
// ════════════════════════════════════════════════════════

model AssessmentGroup {
  id           String   @id @default(cuid())
  name         String
  code         String   @unique
  groupCluster String?
  description  String?  @db.Text
  color        String?
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subGroups    AssessmentSubGroup[]
  testMappings AssessmentGroupMapping[]
  optionScores AssessmentOptionScore[]

  @@index([isActive])
  @@index([order])
  @@map("assessment_groups")
}

model AssessmentGroupMapping {
  id               String   @id @default(cuid())
  testId           String
  groupId          String
  order            Int      @default(0)
  weightMultiplier Float    @default(1)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  test  Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  group AssessmentGroup @relation(fields: [groupId], references: [id])

  @@unique([testId, groupId])
  @@index([testId])
  @@index([groupId])
  @@index([isActive])
  @@map("assessment_group_mappings")
}

model AssessmentVersion {
  id        String   @id @default(cuid())
  testId    String
  version   Int
  config    Json
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())

  test     Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  attempts TestAttempt[]

  @@unique([testId, version])
  @@index([testId])
  @@index([isActive])
  @@map("assessment_versions")
}

model AssessmentSubGroup {
  id          String   @id @default(cuid())
  groupId     String
  name        String
  code        String
  description String?  @db.Text
  color       String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group        AssessmentGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  optionScores AssessmentOptionScore[]

  @@unique([groupId, code])
  @@index([groupId])
  @@index([isActive])
  @@map("assessment_sub_groups")
}

model AssessmentOptionScore {
  id         String   @id @default(cuid())
  optionId   String
  groupId    String
  subGroupId String?
  score      Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  option   Option              @relation(fields: [optionId], references: [id], onDelete: Cascade)
  group    AssessmentGroup     @relation(fields: [groupId], references: [id])
  subGroup AssessmentSubGroup? @relation(fields: [subGroupId], references: [id])

  @@index([optionId])
  @@index([groupId])
  @@index([subGroupId])
  @@map("assessment_option_scores")
}

model AssessmentResultSnapshot {
  id                    String                @id @default(cuid())
  attemptId             String                @unique
  rawScores             Json
  normalizedScores      Json
  rankedGroups          Json
  subGroupScores        Json?
  primaryGroup          Json?
  secondaryGroup        Json?
  tertiaryGroup         Json?
  recommendations       Json?
  recommendationSummary String?               @db.Text
  groupContentSnapshot  Json?
  reportStatus          GeneratedReportStatus @default(PROCESSING)
  generatedAt           DateTime              @default(now())
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  attempt TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([reportStatus])
  @@map("assessment_result_snapshots")
}


// ════════════════════════════════════════════════════════
// ASSESSMENT REPORTING
// ════════════════════════════════════════════════════════

model ReportTemplate {
  id             String   @id @default(cuid())
  name           String
  coverTitle     String?
  page7Heading   String?
  brandingConfig Json?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tests Test[]

  @@index([isActive])
  @@map("report_templates")
}

model ReportJob {
  id           String          @id @default(cuid())
  attemptId    String
  status       ReportJobStatus @default(PENDING)
  priority     Int             @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?         @db.Text
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  attempt TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([status])
  @@index([priority])
  @@map("report_jobs")
}

model GeneratedReport {
  id           String                @id @default(cuid())
  attemptId    String                @unique
  filePath     String?
  fileName     String?
  status       GeneratedReportStatus @default(PROCESSING)
  errorMessage String?               @db.Text
  generatedAt  DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  attempt TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("generated_reports")
}

// ════════════════════════════════════════════════════════
// USER ANSWER (Per-question answer in an attempt)
// ════════════════════════════════════════════════════════

model UserAnswer {
  id                String  @id @default(cuid())
  attemptId         String
  questionId        String
  selectedOptionId  String?
  isMarkedForReview Boolean @default(false)
  isAnswered        Boolean @default(false)
  timeTakenSeconds  Int     @default(0) // Time spent on this question

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempt  TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id])
  option   Option?     @relation(fields: [selectedOptionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@map("user_answers")
}

// ════════════════════════════════════════════════════════
// CMS / PUBLIC WEBSITE MODELS
// ════════════════════════════════════════════════════════

model Blog {
  id          String       @id @default(cuid())
  title       String
  content     String       @db.Text
  excerpt     String?
  thumbnail   String?
  author      String
  categoryId  String
  category    BlogCategory @relation(fields: [categoryId], references: [id])
  isPublished Boolean      @default(false)
  isDeleted   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([categoryId])
  @@index([isPublished])
  @@index([isDeleted])
  @@map("blogs")
}

model BlogCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blogs Blog[]

  @@map("blog_categories")
}

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  designation String?
  content     String
  avatar      String?
  rating      Int      @default(5)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("testimonials")
}

model Team {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String?
  avatar    String?
  twitter   String?
  linkedin  String?
  facebook  String?
  instagram String?
  email     String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("teams")
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  logo      String
  website   String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("partners")
}

model Gallery {
  id        String   @id @default(cuid())
  title     String?
  image     String // Image file path
  category  String? // Optional categorization
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([isDeleted])
  @@map("gallery")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  thumbnail   String?
  eventDate   DateTime // Event date
  eventTime   String? // e.g. "10:30 AM"
  venue       String? // Location text
  buttonText  String?  @default("Get Ticket")
  buttonLink  String? // External link (registration/ticket)
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([isDeleted])
  @@index([eventDate])
  @@map("events")
}

model Banner {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  description String?  @db.Text
  image       String // Main banner image path
  buttonText  String?
  buttonLink  String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@map("banners")
}

model Counter {
  id        String   @id @default(cuid())
  label     String
  value     Int
  icon      String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("counters")
}

model ServicesPage {
  id                  String  @id @default(cuid())
  slug                String  @unique @default("default")
  title               String
  price               String?
  briefIntro          String  @db.Text
  aboutTitle          String
  aboutDescription    String  @db.Text
  aboutImage          String?
  aboutStatus         Boolean @default(true)
  workProcessTitle    String
  workProcessSubTitle String?

  workProcessStepsCount Int      @default(3)
  workProcessSteps      Json
  benefitsMainTitle     String
  benefitsSubTitle      String?
  benefitsCards         Json
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("services_pages")
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  type        String   @default("text")
  group       String   @default("general")
  label       String?
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([group])
  @@index([key])
  @@map("system_settings")
}

model ContactMessage {
  id            String   @id @default(cuid())
  userId        String?
  name          String
  email         String
  contactNumber String?
  subject       String
  message       String   @db.Text
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([isRead])
  @@index([createdAt])
  @@map("contact_messages")
}

enum NewsletterSubscriberStatus {
  SUBSCRIBED
  CONTACTED
  UNSUBSCRIBED
  ARCHIVED
}

model NewsletterSubscriber {
  id              String                     @id @default(cuid())
  email           String                     @unique
  name            String?
  source          String?                    @default("website")
  status          NewsletterSubscriberStatus @default(SUBSCRIBED)
  notes           String?                    @db.Text
  subscribedAt    DateTime                   @default(now())
  lastContactedAt DateTime?
  unsubscribedAt  DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([subscribedAt])
  @@map("newsletter_subscribers")
}

// ════════════════════════════════════════════════════════
// RECYCLE BIN (Soft-delete tracking)
// ════════════════════════════════════════════════════════

model RecycleBinEntry {
  id           String    @id @default(cuid())
  module       String // "course", "test", "question", etc.
  entityType   String // Same as module usually
  recordId     String
  recordLabel  String? // Human-readable label
  payload      Json // Snapshot of the deleted record
  deletedById  String?
  deletedAt    DateTime  @default(now())
  restoredById String?
  restoredAt   DateTime?

  @@index([module])
  @@index([entityType])
  @@index([recordId])
  @@index([deletedAt])
  @@index([restoredAt])
  @@map("recycle_bin_entries")
}
